# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL=postgresql://qms:qms@localhost:5432/qms?schema=public

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:3001

# Set to the number of proxy hops in front of the app (e.g. 1 behind a load balancer). 0 = none.
TRUST_PROXY=0

# --- Added when the auth module is built (see docs/ARCHITECTURE.md §7) ---
# JWT_ACCESS_SECRET=          # >= 32 random chars
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true
